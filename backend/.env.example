PORT=3000
PUBLIC_API_URL=https://your-backend-api.onrender.com
CLIENT_ORIGIN=https://your-storefront.vercel.app
VITE_API_URL=https://your-backend-api.onrender.com/api
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (MySQL / Aiven / PlanetScale)
DB_HOST=your_mysql_host
DB_PORT=3306
DB_NAME=torado_store
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Customer auth & SMTP email
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
MAIL_FROM=Torado Store <your_email@gmail.com>

# Razorpay Payment Gateway (Live or Test keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Initial Admin Credentials
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@torado.com
ADMIN_PASSWORD=YourSecureAdminPassword123

# WhatsApp / SMS API (Optional - Twilio / Fast2SMS / Wati)
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
